{
  "name": "@paranoia/desktop",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "wasm": "node ../../scripts/build-wasm.mjs",
    "engine": "cargo build --release -p paranoia-engine",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test electron/plugins.test.cjs electron/ai.test.cjs electron/policy.test.cjs",
    "app": "npm run build && electron .",
    "app:dev": "node ../../scripts/dev-desktop.mjs",
    "dist": "npm run dist:win",
    "dist:win": "npm run wasm && npm run engine && npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run wasm && npm run engine && npm run build && electron-builder --linux --publish never",
    "dist:mac": "npm run wasm && npm run engine && npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^2.1.9",
    "typescript": "7.0",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  },
  "description": "Paranoia — open-source reverse engineering platform",
  "author": "Paranoia contributors",
  "homepage": "https://github.com/Altumptic/paranoia",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.paranoia.desktop",
    "productName": "Paranoia",
    "copyright": "Copyright © 2026 Paranoia contributors",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Paranoia-${version}-${arch}-${target}.${ext}",
      "signExts": [
        ".exe"
      ],
      "signtoolOptions": {
        "publisherName": "Paranoia contributors",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "extraResources": [
        {
          "from": "../../target/release/paranoia-engine.exe",
          "to": "engine/paranoia-engine.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Paranoia",
      "uninstallDisplayName": "Paranoia",
      "artifactName": "Paranoia-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Paranoia-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "paranoia",
      "maintainer": "Paranoia contributors <thefear078@gmail.com>",
      "synopsis": "Local-first reverse-engineering tool for PE, ELF and Mach-O",
      "artifactName": "Paranoia-${version}-linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": "../../target/release/paranoia-engine",
          "to": "engine/paranoia-engine"
        }
      ]
    },
    "deb": {
      "packageName": "paranoia",
      "packageCategory": "devel"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Paranoia-${version}-mac-${arch}.${ext}",
      "binaries": [
        "Contents/Resources/engine/paranoia-engine"
      ],
      "extraResources": [
        {
          "from": "../../target/release/paranoia-engine",
          "to": "engine/paranoia-engine"
        }
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false
    }
  }
}
